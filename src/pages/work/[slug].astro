---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project, index) => {
    const nextProject = projects[(index + 1) % projects.length];
    return {
      params: { slug: project.id },
      props: { project, nextProject }
    };
  });
}

const { project, nextProject } = Astro.props;
const {
  title,
  client,
  category,
  year,
  brief,
  concept,
  deliverables,
  heroImage,
  gallery,
  colorPalette,
  credits
} = project.data;
---

<BaseLayout title={title} description={brief}>
  <article class="case-detail-page">
    <!-- Case Header -->
    <header class="case-header">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/work">Work</a>
          <span>/</span>
          <span class="current">{title}</span>
        </div>

        <div class="case-header-content">
          <div class="meta-tags-row">
            <span class="tag-pill">{category}</span>
            <span class="tag-meta">Year {year}</span>
          </div>

          <h1 class="case-h1">{title}</h1>
          <p class="case-client-lead">Client: <span class="client-highlight">{client}</span></p>
        </div>
      </div>
    </header>

    <!-- Hero Image / Feature Frame -->
    <div class="case-hero-image-wrap">
      <div class="container">
        <div class="hero-frame" data-cursor-text="EXPAND">
          <img src={heroImage} alt={`Visual identity for ${title}`} class="hero-img-full" />
        </div>
      </div>
    </div>

    <!-- Brief, Concept & Deliverables Grid -->
    <section class="case-narrative-section">
      <div class="container narrative-grid">
        <div class="narrative-left">
          <div class="brief-box">
            <span class="tag-meta">// THE BRIEF & STRATEGIC CHALLENGE</span>
            <p class="brief-text">{brief}</p>
          </div>

          <div class="concept-box">
            <h2 class="concept-title">Art Direction <span class="heading-alt">& Motion Concept</span></h2>
            <p class="concept-text">{concept}</p>
          </div>

          <!-- Color Identity Swatches -->
          <div class="project-palette-box">
            <span class="tag-meta">// COLOR IDENTITY SYSTEM</span>
            <div class="palette-swatches">
              {colorPalette.map(hex => (
                <div class="swatch-item">
                  <span class="swatch-box" style={`background-color: ${hex};`}></span>
                  <span class="swatch-hex">{hex}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar with Deliverables & Credits -->
        <aside class="case-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">Core Deliverables</h3>
            <ul class="deliverables-ul">
              {deliverables.map(item => (
                <li>
                  <span class="arrow-bullet" aria-hidden="true">→</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="credits-block">
              <h4 class="credits-heading">Production Credits</h4>
              <dl class="credits-dl">
                <div>
                  <dt>Creative & Art Direction:</dt>
                  <dd>{credits.artDirection}</dd>
                </div>
                <div>
                  <dt>Graphic & Motion Design:</dt>
                  <dd>{credits.design}</dd>
                </div>
                <div>
                  <dt>Creative Technology:</dt>
                  <dd>{credits.development}</dd>
                </div>
              </dl>
            </div>

            <div class="sidebar-cta">
              <a href="/contact" class="btn btn-primary btn-block" data-cursor-text="LET'S TALK">
                Start a similar project →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Visual Gallery Grid -->
    <section class="case-gallery-section">
      <div class="container">
        <div class="gallery-grid">
          {gallery.map(item => (
            <div class:list={['gallery-cell', `span-${item.span}`]} data-cursor-text="INSPECT">
              <img src={item.src} alt={item.alt} loading="lazy" class="gallery-photo" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Next Case Navigation -->
    <nav class="next-case-nav" aria-label="Navigate to next case study">
      <div class="container">
        <a href={`/work/${nextProject.id}`} class="next-case-link" data-cursor-text="NEXT CASE →">
          <div class="next-info">
            <span class="tag-meta">// NEXT SELECTED WORK →</span>
            <h2 class="next-case-title">{nextProject.data.title}</h2>
            <span class="next-case-cat">{nextProject.data.category}</span>
          </div>
          <div class="next-thumb">
            <img src={nextProject.data.heroImage} alt={nextProject.data.title} class="next-thumb-img" />
          </div>
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .case-header {
    padding: 3rem 0 2rem;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb .current {
    color: var(--color-text-primary);
  }

  .meta-tags-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .case-h1 {
    margin-bottom: 0.5rem;
  }

  .case-client-lead {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }

  .client-highlight {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Hero Frame */
  .case-hero-image-wrap {
    padding: 2.5rem 0 3.5rem;
  }

  .hero-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .hero-img-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Narrative Grid */
  .case-narrative-section {
    padding-bottom: 5rem;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .narrative-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 5rem;
    }
  }

  .brief-box {
    margin-bottom: 2.5rem;
  }

  .brief-text {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    line-height: 1.55;
    margin-top: 0.75rem;
  }

  .concept-title {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .concept-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
  }

  .project-palette-box {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .palette-swatches {
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .swatch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .swatch-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
  }

  .swatch-hex {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* Sidebar */
  .sidebar-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-title {
    font-size: 1.15rem;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .deliverables-ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .deliverables-ul li {
    display: flex;
    gap: 0.5rem;
    color: var(--color-text-secondary);
  }

  .arrow-bullet {
    color: var(--color-accent);
  }

  .credits-block {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .credits-heading {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .credits-dl {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .credits-dl dt {
    color: var(--color-text-muted);
  }

  .credits-dl dd {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .btn-block {
    width: 100%;
    text-align: center;
  }

  /* Galería */
  .case-gallery-section {
    padding-bottom: 6rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .span-full {
      grid-column: span 2;
    }
  }

  .gallery-cell {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .gallery-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Next Case */
  .next-case-nav {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    padding: 4rem 0;
  }

  .next-case-link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    align-items: center;
    transition: all 0.25s ease;
  }

  .next-case-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (min-width: 768px) {
    .next-case-link {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .next-case-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 0.5rem 0 0.5rem;
  }

  .next-case-cat {
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .next-thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-xs);
  }

  .next-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
