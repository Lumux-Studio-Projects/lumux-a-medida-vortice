---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';

const team = [
  {
    name: "Iker Domínguez",
    role: "Executive Creative Director & Co-Founder",
    bio: "12+ years defining visual and kinetic languages for high-growth tech disruptors, luxury brands, and contemporary cultural icons across Europe and the Americas.",
    photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Valeria Monroy",
    role: "Head of Creative Technology & 3D WebGL",
    bio: "Pioneer in interactive GPU shaders, spatial animation, and ultra-performant frontends. Obsessed with crafting tactile digital flagships that hit 60fps on mobile.",
    photo: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80"
  }
];

const pillars = [
  {
    title: "Insight Over Aesthetic Fluff",
    text: "Visual trends rot in weeks. We anchor every 3D model, motion curve, and hook in behavioral psychology so your creative commands sustained market authority."
  },
  {
    title: "Zero-Friction Technology",
    text: "Motion and WebGL only matter if they supercharge user emotion and conversion. We never ship gimmick effects that hijack scroll behavior or lag on real mobile devices."
  },
  {
    title: "High-Velocity Commercial Impact",
    text: "Great creative isn't decorative artwork for empty galleries; it's the sharpest commercial lever you have to charge premium rates and crush customer acquisition costs."
  }
];
---

<BaseLayout 
  title="The Studio & Manifesto" 
  description="Manifesto, principles, and team behind Vórtice Creative Labs."
>
  <div class="page-header">
    <div class="container">
      <span class="tag-pill">
        <span class="tag-dot"></span>
        <span>THE CREATIVE LABS</span>
      </span>
      <h1 class="header-h1">BUILT FOR BRANDS <span class="heading-alt">THAT REFUSE TO BLEND IN.</span></h1>
      <p class="header-lead">
        Headquartered between Amsterdam and CDMX, Vórtice operates as an agile strike-force for founders, global performance teams, and disruptive market leaders.
      </p>
    </div>
  </div>

  <!-- Deep Manifesto -->
  <section class="manifesto-deep-section">
    <div class="container manifesto-grid">
      <div class="manifesto-lead-col">
        <span class="sub-badge">CORE MANIFESTO</span>
        <h2 class="manifesto-big-text">
          WE BELIEVE IN THE POWER OF THE UNIGNORABLE.
        </h2>
      </div>

      <div class="manifesto-body-col">
        <p class="p-lead">
          The internet is choked with safe, template-ridden corporate banality. Most agencies charge six figures to produce homogenized visual noise that audiences instinctively scroll past in 0.2 seconds.
        </p>
        <p>
          We exist to shatter that cycle. We combine the narrative soul of a high-end European art direction atelier with the ruthless conversion discipline of performance marketing.
        </p>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="pillars-section">
    <div class="container">
      <div class="pillars-header text-center">
        <span class="tag-pill">
          <span class="tag-dot"></span>
          <span>FOUNDATIONAL PRINCIPLES</span>
        </span>
        <h2 class="pillars-title">How We Think & Operate</h2>
      </div>

      <div class="pillars-grid">
        {pillars.map((pillar, index) => (
          <div class="pillar-card">
            <span class="pillar-num">0{index + 1}</span>
            <h3 class="pillar-h3">{pillar.title}</h3>
            <p class="pillar-text">{pillar.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="team-section">
    <div class="container">
      <div class="team-header text-center">
        <span class="tag-pill">
          <span class="tag-dot"></span>
          <span>LEADERSHIP</span>
        </span>
        <h2 class="team-title">Partners In Direct Dialogue</h2>
        <p class="team-desc">No bait-and-switch junior handoffs. You work directly with the makers from kickoff to final render.</p>
      </div>

      <div class="team-grid">
        {team.map((member) => (
          <div class="team-card" data-cursor-text="PARTNER">
            <div class="member-photo-wrap">
              <img src={member.photo} alt={member.name} class="member-photo" />
            </div>
            <div class="member-meta">
              <h3 class="member-name">{member.name}</h3>
              <span class="member-role">{member.role}</span>
              <p class="member-bio">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .header-h1 {
    margin: 1.25rem 0 1.5rem;
  }

  .header-lead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
  }

  /* Deep Manifesto */
  .manifesto-deep-section {
    padding: clamp(5rem, 8vw, 8rem) 0;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 960px) {
    .manifesto-grid {
      grid-template-columns: 1fr 1.25fr;
      gap: 5rem;
      align-items: center;
    }
  }

  .sub-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1rem;
  }

  .manifesto-big-text {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-text-primary);
  }

  .manifesto-body-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .p-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .manifesto-body-col p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* Pillars */
  .pillars-section {
    padding: clamp(5rem, 8vw, 8rem) 0;
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .pillars-header {
    max-width: 680px;
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  }

  .pillars-title {
    margin-top: 0.75rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .pillar-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .pillar-h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .pillar-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Team */
  .team-section {
    padding: clamp(5rem, 8vw, 8rem) 0;
    background-color: var(--color-bg-secondary);
  }

  .team-header {
    max-width: 680px;
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  }

  .team-title {
    margin-top: 0.75rem;
  }

  .team-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 980px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem;
    }
  }

  .team-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-accent);
  }

  .member-photo-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .team-card:hover .member-photo {
    transform: scale(1.05);
  }

  .member-meta {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .member-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .member-role {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .member-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .text-center {
    text-align: center;
  }
</style>
