---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  {
    code: "CAP-01",
    title: "High-Octane 3D Motion & CGI",
    lead: "Photorealistic kinetic product unboxings, spatial lighting, and dynamic simulations that command undivided attention.",
    deliverables: [
      "Cinema 4D & Blender spatial animation",
      "Cloth physics, fluid & particle simulations",
      "4K cinematic multi-ratio exports (9:16, 16:9, 1:1)",
      "High-energy bespoke sound design & foley"
    ]
  },
  {
    code: "CAP-02",
    title: "60fps WebGL Digital Flagships",
    lead: "Interactive web experiences and 3D product configurators engineered for extreme speed with zero framework bloat.",
    deliverables: [
      "Custom Three.js & GLSL shader architecture",
      "Headless Astro, React & TypeScript engineering",
      "Sub-second mobile loading with 95+ Lighthouse",
      "Fluid scroll-driven GSAP micro-interactions"
    ]
  },
  {
    code: "CAP-03",
    title: "Viral Social Content & Ad Creative",
    lead: "Performance-engineered video reels, UGC assets, and organic loops designed to dominate TikTok, Meta, and YouTube Shorts.",
    deliverables: [
      "Thumb-stopping hook scripting (first 0.6s)",
      "Multi-angle creative testing variations",
      "Live-action & CGI hybrid editing workflows",
      "Statistical ROAS creative iteration sprints"
    ]
  },
  {
    code: "CAP-04",
    title: "Creative Strategy & Brand Architecture",
    lead: "Deconstructing audience psychology and competitor ad fatigue before a single polygon is modeled.",
    deliverables: [
      "Audience psychological trigger mapping",
      "12+ angle concept matrices & style frames",
      "Radical typography & motion guidelines",
      "Scalable digital design systems"
    ]
  }
];

const processSteps = [
  { step: "01", name: "Audit & Hook Extraction", desc: "We deconstruct category noise and isolate the exact angles with statistical conversion probability." },
  { step: "02", name: "Style Frames & 3D Layout", desc: "Live in-browser prototypes and photorealistic lighting boards in 48 hours — zero theoretical PDFs." },
  { step: "03", name: "Motion Sim & Clean Code", desc: "Engineered for 60fps GPU execution, sub-second mobile loads, and pristine typography." },
  { step: "04", name: "Multi-Format Global Deploy", desc: "Full delivery of 4K master exports, raw 3D assets, and production repos with complete IP transfer." }
];
---

<BaseLayout 
  title="Capabilities & Production Services" 
  description="High-velocity 3D motion, viral social content, and 60fps WebGL digital flagships engineered by Vórtice."
>
  <div class="page-header">
    <div class="container">
      <span class="tag-pill">
        <span class="tag-dot"></span>
        <span>PRODUCTION DISCIPLINES</span>
      </span>
      <h1 class="header-h1">CREATIVE FIREPOWER <span class="heading-alt">THAT CONVERTS.</span></h1>
      <p class="header-lead">
        We don't do everything. We obsess exclusively over four disciplines where radical visual craft and technical speed deliver unfair market advantage.
      </p>
    </div>
  </div>

  <!-- Capabilities Grid -->
  <section class="capabilities-section">
    <div class="container">
      <div class="capabilities-grid">
        {capabilities.map((cap) => (
          <div class="cap-card" data-cursor-text="SPEC →">
            <span class="cap-code">{cap.code}</span>
            <h2 class="cap-title">{cap.title}</h2>
            <p class="cap-lead">{cap.lead}</p>
            
            <div class="cap-deliverables">
              <span class="deliv-title">KEY DELIVERABLES</span>
              <ul>
                {cap.deliverables.map((item) => (
                  <li>✦ {item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="process-section">
    <div class="container">
      <div class="process-header">
        <span class="tag-pill">
          <span class="tag-dot"></span>
          <span>THE SPRINT CADENCE</span>
        </span>
        <h2 class="process-title">How we forge in 5 business days</h2>
        <p class="process-desc">Senior creative directors and technical leads in direct dialogue with founders.</p>
      </div>

      <div class="process-grid">
        {processSteps.map((p) => (
          <div class="process-card">
            <span class="p-step">{p.step}</span>
            <h3 class="p-name">{p.name}</h3>
            <p class="p-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner-section">
    <div class="container text-center">
      <h2 class="cta-title">Have a launch or performance campaign to ignite?</h2>
      <p class="cta-desc">Lock in your 5-day creative sprint. We onboard max 3 brands per cycle.</p>
      <a href="/contact" class="btn btn-primary btn-large" data-cursor-text="LET'S TALK">
        <span>Initiate Creative Brief</span>
        <span class="btn-arrow-icon">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .header-h1 {
    margin: 1.25rem 0 1.5rem;
  }

  .header-lead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
  }

  /* Capabilities Grid */
  .capabilities-section {
    padding: clamp(4rem, 7vw, 7rem) 0;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cap-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .cap-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .cap-code {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
    letter-spacing: 0.08em;
  }

  .cap-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .cap-lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .cap-deliverables {
    margin-top: auto;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border-light);
  }

  .deliv-title {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.85rem;
  }

  .cap-deliverables ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* Process */
  .process-section {
    padding: clamp(4rem, 7vw, 7rem) 0;
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .process-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  }

  .process-title {
    margin-top: 0.75rem;
  }

  .process-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.25s ease;
  }

  .process-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .p-step {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-accent);
  }

  .p-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .p-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* CTA */
  .cta-banner-section {
    padding: clamp(5rem, 8vw, 8rem) 0;
    background-color: var(--color-bg-secondary);
  }

  .cta-title {
    margin-bottom: 1rem;
  }

  .cta-desc {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
  }

  .btn-large {
    padding: 1.15rem 2.5rem;
    font-size: 1.05rem;
  }

  .text-center {
    text-align: center;
  }
</style>
