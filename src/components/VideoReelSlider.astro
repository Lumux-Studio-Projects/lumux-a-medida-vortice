<style>
  .reel-slider-wrapper {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    padding: 1.5rem 0 3.5rem;
    user-select: none;
  }

  .reel-slider-track {
    display: flex;
    width: max-content;
    animation: reelMarquee 38s linear infinite;
  }

  .reel-slider-track:hover {
    animation-play-state: paused;
  }

  .reel-slider-group {
    display: flex;
    gap: 1.75rem;
    padding-right: 1.75rem;
  }

  @keyframes reelMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .reel-card {
    width: clamp(280px, 24vw, 340px);
    height: clamp(400px, 32vw, 470px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    cursor: pointer;
  }

  .reel-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: var(--color-accent);
  }

  .reel-media-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .reel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .reel-card:hover .reel-img {
    transform: scale(1.08);
  }

  .reel-glow-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.45) 50%,
      rgba(12, 13, 16, 0.92) 100%
    );
  }

  .reel-play-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: #FFFFFF;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .reel-card:hover .reel-play-btn {
    transform: scale(1.15);
    background-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .reel-tag-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    padding: 0.25rem 0.65rem;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.06em;
  }

  .reel-info {
    position: relative;
    z-index: 10;
    padding: 1.5rem;
  }

  .reel-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.45rem;
    letter-spacing: -0.02em;
  }

  .reel-stat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .stat-arrow {
    color: var(--color-accent);
    font-size: 0.95rem;
  }

  .stat-highlight {
    color: var(--color-accent);
  }
</style>
