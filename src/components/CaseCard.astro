---
interface Props {
  title: string;
  client: string;
  category: string;
  year: number;
  heroImage: string;
  slug: string;
  index: number;
}

const {
  title,
  client,
  category,
  year,
  heroImage,
  slug,
  index
} = Astro.props;
---

<article class="case-card">
  <a href={`/work/${slug}`} class="case-media-link" aria-label={`View case study ${title}`}>
    <div class="case-image-frame">
      <img src={heroImage} alt={`Case study ${title}`} loading="lazy" class="case-img" />
      <div class="case-overlay">
        <span class="btn btn-primary btn-case" data-cursor-text="VIEW CASE">View Case Study →</span>
      </div>
    </div>
  </a>

  <div class="case-info">
    <div class="case-meta-line">
      <span class="case-number">0{index + 1}</span>
      <span class="case-cat tag-meta">{category}</span>
      <span class="case-year tag-meta">{year}</span>
    </div>

    <h3 class="case-title">
      <a href={`/work/${slug}`}>{title}</a>
    </h3>
    <span class="case-client">{client}</span>
  </div>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .case-media-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  .case-image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .case-media-link:hover .case-img {
    transform: scale(1.05);
  }

  .case-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 12, 14, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .case-media-link:hover .case-overlay {
    opacity: 1;
  }

  .btn-case {
    font-size: 0.75rem;
    padding: 0.65rem 1.25rem;
  }

  .case-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .case-meta-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .case-number {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .case-title {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-top: 0.2rem;
  }

  .case-title a {
    transition: color 0.15s ease;
  }

  .case-title a:hover {
    color: var(--color-accent);
  }

  .case-client {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
