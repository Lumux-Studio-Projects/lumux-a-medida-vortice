---
interface Props {
  text?: string;
  size?: number;
  class?: string;
}

const {
  text = "★ VÓRTICE CREATIVE ATELIER ★ PARIS · CDMX ★ EST. 2024 ",
  size = 140,
  class: className = ""
} = Astro.props;
---

<div class:list={["seal-wrapper", className]} style={`--seal-size: ${size}px;`}>
  <svg 
    viewBox="0 0 200 200" 
    class="seal-svg" 
    aria-hidden="true"
    width={size} 
    height={size}
  >
    <defs>
      <!-- Circular path for text rotation -->
      <path
        id="sealCirclePath"
        d="M 100, 100 m -72, 0 a 72,72 0 1,1 144,0 a 72,72 0 1,1 -144,0"
      />
    </defs>

    <!-- Outer and inner fine borders -->
    <circle cx="100" cy="100" r="94" class="seal-border-outer" />
    <circle cx="100" cy="100" r="50" class="seal-border-inner" />

    <!-- Rotating Typography along path -->
    <text class="seal-text">
      <textPath href="#sealCirclePath" startOffset="0%" textLength="452" lengthAdjust="spacingAndGlyphs">
        {text}
      </textPath>
    </text>

    <!-- Center Icon: Architectural Asterisk / Spark -->
    <g class="seal-center-mark" transform="translate(100, 100)">
      <circle cx="0" cy="0" r="8" fill="var(--color-accent)" />
      <path d="M-14,0 L14,0 M0,-14 L0,14 M-10,-10 L10,10 M-10,10 L10,-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
    </g>
  </svg>
</div>

<style>
  .seal-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--seal-size);
    height: var(--seal-size);
    position: relative;
    user-select: none;
  }

  .seal-svg {
    width: 100%;
    height: 100%;
    color: var(--color-text-primary);
    overflow: visible;
    animation: rotateSeal 24s linear infinite;
    transform-origin: center center;
  }

  @keyframes rotateSeal {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .seal-svg {
      animation: none;
    }
  }

  .seal-border-outer {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  .seal-border-inner {
    fill: var(--color-bg-card);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .seal-text {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    fill: var(--color-text-primary);
    text-transform: uppercase;
  }

  .seal-center-mark {
    color: var(--color-text-primary);
    transition: transform 0.3s ease;
  }

  .seal-wrapper:hover .seal-center-mark {
    transform: translate(100, 100) scale(1.15) rotate(45deg);
  }
</style>
